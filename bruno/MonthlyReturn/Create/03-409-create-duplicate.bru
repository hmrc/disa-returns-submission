meta {
  name: 03-409-create-duplicate
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}{{servicePath}}/monthly/{{zReference}}/{{taxYear}}/{{month}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nilReturn": false
  }
}

assert {
  res.status: eq 409
}

script:pre-request {
  const response = await bru.runRequest("MonthlyReturn/Create/01-201-create-nil-return-false");
  
  if (response.status !== 201) {
    throw new Error(`Expected monthly return setup to respond with 201, got ${response.status}`);
  }
  
  if (!bru.getVar("monthlySubmissionId")) {
    throw new Error("Expected monthly return setup to store monthlySubmissionId");
  }
}

tests {
  test("response contains existing submissionId", function() {
    if (res.status !== 409) {
      return;
    }
  
    const responseBody = res.body ?? res.getBody();
    const body = typeof responseBody === "string" ? JSON.parse(responseBody) : responseBody;
  
    expect(body.submissionId).to.equal(bru.getVar("monthlySubmissionId"));
  });
}
