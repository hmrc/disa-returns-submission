meta {
  name: 05-400-invalid-params
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}{{servicePath}}/monthly/{{invalidZReference}}/{{invalidTaxYear}}/{{invalidMonth}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nilReturn": false
  }
}

assert {
  res.status: eq 400
}
