meta {
  name: 03-409-reject-stored-submission
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}{{servicePath}}/monthly/{{zReference}}/{{taxYear}}/{{month}}/submissions/{{putSubmissionId}}
  body: text
  auth: none
}

headers {
  Content-Type: application/x-ndjson
}

body:text {
  {"id":"1","name":"duplicate record"}
}

assert {
  res.status: eq 409
}

script:pre-request {
  const storedResponse = await bru.runRequest("MonthlyReturn/Submissions/01-200-store-new-submission");

  if (storedResponse.status !== 200) {
    throw new Error(`Expected submission setup to respond with 200, got ${storedResponse.status}`);
  }
}
