meta {
  name: 05-404-monthly-return-not-found
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}{{servicePath}}/monthly/{{missingZReference}}/{{taxYear}}/{{month}}/submissions/{{putSubmissionId}}
  body: text
  auth: none
}

headers {
  Content-Type: application/x-ndjson
}

body:text {
  {"id":"1","name":"missing return record"}
}

assert {
  res.status: eq 404
}

script:pre-request {
  const value = (Date.now() + Math.floor(Math.random() * 1000)) % 10000;
  const missingZReference = `Z${value.toString().padStart(4, "0")}`;
  bru.setVar("missingZReference", missingZReference);
  bru.setVar("putSubmissionId", `missing-${Date.now()}`);

  const cleanupUrl = `${bru.getEnvVar("baseUrl")}${bru.getEnvVar("servicePath")}/test-only/monthly-returns`;
  const cleanupResponse = await bru.sendRequest({
    method: "POST",
    url: cleanupUrl,
    headers: { "Content-Type": "application/json" },
    data: { zReferences: [missingZReference] },
    timeout: 3000
  });

  if (cleanupResponse.status !== 204) {
    throw new Error(`Expected monthly return cleanup to respond with 204, got ${cleanupResponse.status}`);
  }
}
