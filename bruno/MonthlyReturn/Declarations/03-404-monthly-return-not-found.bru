meta {
  name: 03-404-monthly-return-not-found
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}{{servicePath}}/monthly/{{missingZReference}}/{{taxYear}}/{{month}}/declarations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nilReturn": false
  }
}

assert {
  res.status: eq 404
}

script:pre-request {
  const value = (Date.now() + Math.floor(Math.random() * 1000)) % 10000;
  const missingZReference = `Z${value.toString().padStart(4, "0")}`;
  bru.setVar("missingZReference", missingZReference);
  bru.setVar("clockZReference", missingZReference);

  const clockResponse = await bru.runRequest("TestOnly/Overrides/06-200-set-clock-inside-declaration-period");

  if (clockResponse.status !== 200) {
    throw new Error(`Expected clock setup to respond with 200, got ${clockResponse.status}`);
  }

  const cleanupUrl = `${bru.getEnvVar("baseUrl")}${bru.getEnvVar("servicePath")}/test-only/monthly-returns`;
  const cleanupResponse = await bru.sendRequest({
    method: "POST",
    url: cleanupUrl,
    headers: { "Content-Type": "application/json" },
    data: { zReferences: [missingZReference] },
    timeout: 3000
  });

  if (cleanupResponse.status !== 204) {
    throw new Error(`Expected monthly return cleanup to respond with 204, got ${cleanupResponse.status}`);
  }
}
