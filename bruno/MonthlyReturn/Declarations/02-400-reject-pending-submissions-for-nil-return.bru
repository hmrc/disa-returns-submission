meta {
  name: 02-400-reject-pending-submissions-for-nil-return
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{servicePath}}/monthly/{{zReference}}/{{taxYear}}/{{month}}/declarations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nilReturn": true,
    "pendingSubmissionIds": [
      "{{putSubmissionId}}"
    ]
  }
}

assert {
  res.status: eq 400
}

script:pre-request {
  const clockResponse = await bru.runRequest("TestOnly/Clock/02-200-set-clock-inside-declaration-period");

  if (clockResponse.status !== 200) {
    throw new Error(`Expected clock setup to respond with 200, got ${clockResponse.status}`);
  }

  const value = (Date.now() + Math.floor(Math.random() * 1000)) % 10000;
  bru.setVar("zReference", `Z${value.toString().padStart(4, "0")}`);
  bru.setVar("putSubmissionId", `invalid-pending-${Date.now()}`);
}
