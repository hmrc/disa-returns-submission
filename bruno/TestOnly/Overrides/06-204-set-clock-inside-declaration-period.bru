meta {
  name: 06-204-set-clock-inside-declaration-period
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}{{servicePath}}/test-only/overrides
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "zReferences": ["{{clockZReference}}"],
    "clock": {
      "date": "{{declarationPeriodDate}}"
    }
  }
}

assert {
  res.status: eq 204
}
