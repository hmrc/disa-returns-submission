meta {
  name: 02-204-replace-overrides
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}{{servicePath}}/test-only/overrides
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "zReferences": ["{{overrideZReference}}"],
    "clock": {
      "date": "{{outsideDeclarationPeriodDate}}"
    },
    "reportingWindow": {
      "startDate": "{{reportingWindowOverrideStart}}",
      "endDate": "{{reportingWindowOverrideEnd}}"
    }
  }
}

assert {
  res.status: eq 204
}
