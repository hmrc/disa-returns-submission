meta {
  name: 05-400-invalid-window
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}{{servicePath}}/test-only/overrides
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "zReferences": ["{{overrideZReference}}"],
    "reportingWindow": {
      "startDate": "{{reportingWindowOverrideEnd}}",
      "endDate": "{{reportingWindowOverrideStart}}"
    }
  }
}

assert {
  res.status: eq 400
}
