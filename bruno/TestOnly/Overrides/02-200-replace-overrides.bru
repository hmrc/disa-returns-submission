meta {
  name: 02-200-replace-overrides
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}{{servicePath}}/test-only/overrides/{{overrideZReference}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "clock": {
      "date": "{{outsideDeclarationPeriodDate}}"
    },
    "reportingWindow": {
      "startDate": "{{reportingWindowOverrideStart}}",
      "endDate": "{{reportingWindowOverrideEnd}}"
    }
  }
}

assert {
  res.status: eq 200
  res.body.clock.date: eq {{outsideDeclarationPeriodDate}}
}
