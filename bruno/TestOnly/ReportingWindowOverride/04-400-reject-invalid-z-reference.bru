meta {
  name: 04-400-reject-invalid-z-reference
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}{{servicePath}}/test-only/reporting-window-override/{{invalidZReference}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "startDate": "{{reportingWindowOverrideStart}}",
    "endDate": "{{reportingWindowOverrideEnd}}"
  }
}

assert {
  res.status: eq 400
}
